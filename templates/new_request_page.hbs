{{! Subheader }}
<div class="bg-gray-200">
  <div class="container">
    <div class="row align-items-center pt-4">
      <div class="col font-size-md">
        {{breadcrumbs}}
      </div>
      {{~#is settings.header_search_style 'none'}}
        <div class="md:col-4">
          <div class="search mb-4">
            <h2 class="sr-only">{{t 'search' }}</h2>
            {{~#if settings.search_placeholder}}
              {{#if settings.use_translations}}
                {{search class='form-field mb-0' instant=settings.instant_search scoped=settings.scoped_kb_search submit=false placeholder=(dc settings.search_placeholder)}}
              {{else}}
                {{search class='form-field mb-0' instant=settings.instant_search scoped=settings.scoped_kb_search submit=false placeholder=settings.search_placeholder}}
              {{/if}}
            {{else}}
              {{search class='form-field mb-0' instant=settings.instant_search scoped=settings.scoped_kb_search submit=false}}
            {{/if~}}
            <svg class="search-icon fill-current transition" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" aria-hidden="true">
              <use xlink:href="#icon-search" />
            </svg>
          </div>
        </div>
      {{/is~}}
    </div>
  </div>
</div>

<div class="container" id="page-container">
  <div class="row">
    <div class="lg:col-9">

      {{! Form heading }}
      <div class="mb-5">
        <h1>
          {{t 'submit_a_request'}}
        </h1>
        {{follow_up}}
      </div>
      <div class="form">

        {{! New request tip }}
        {{~#if settings.form_tip}}
          <div id="form-tip"></div>
          <script type="text/javascript">
            ready(function() {
              var formSelectionField = document.getElementById('request_issue_type_select') || document.getElementById('request_ticket_form_id');
              if (formSelectionField && formSelectionField.value && formSelectionField.value !== '-') {
                Util.renderTemplate(document.getElementById('form-tip'), 'form-tip');
              }
            });
          </script>
        {{/if~}}

        {{! New request form }}
        {{request_form wysiwyg=true}}

      </div>
    </div>

  </div> {{! /.row }}
</div> {{! /#page-container }}

{{! Custom form list }}
{{#isnt settings.form_list_style 'standard'}}
<script type="text/javascript" defer src="{{asset 'extension-forms.min.js'}}"></script>
<script type="text/javascript">
  ready(function() {
    new Forms(document.getElementById('new_request'), { template: 'form-list' });
  });
</script>
{{/isnt}}

<script type="text/javascript">document.documentElement.classList.add('new-request-page')</script>

{{!-- Access Permission Request 관련 로직 --}}
<script type="module">
  const isLoggedIn = {{signed_in}};
  const PERMISSION_REQUEST_FORM_ID = "26443122488476"; // Access Permission Request Form ID
  const descriptionPlaceholderKo = `<p><strong>이름 및 신청 사유, 소속을 작성해주세요</strong></p><ul><li>이름: 김현대</li><li>신청 사유: CCI VOC 운영, 권역 담당자</li><li>소속: 고객센터</li></ul>`;
  const descriptionPlaceholderEn = `<p><strong>Enter your name, reason for request, and department/affiliation</strong></p><ul><li>Name: Hyundai Kim</li><li>Purpose: Service Operation</li><li>Affiliation: Customer Contact Center</li></ul>`;

  
  const getCurrentUserInfo = async () => {
    const req = await fetch('/api/v2/users/me');
    const res = await req.json();
    return res?.user || {}
  }

  const setEmailFieldValue = (value) => {
    const targetId = 26522937033756;
    const targetField = document.querySelector(`#request_custom_fields_${targetId}`);
    const targetValue = targetField?.value || "";
    if (targetField && !targetValue) {
      targetField.value = value;
    }
  }

  const setDescriptionDefault = (lang) => {
    const defaultHtml = lang === 'ko' ? descriptionPlaceholderKo : descriptionPlaceholderEn;

    const paste = (editable) => {
      const ckInstance = editable.ckeditorInstance;
      if (ckInstance) {
        ckInstance.setData(defaultHtml);
        return;
      }
      editable.focus();
      const dt = new DataTransfer();
      dt.setData('text/html', defaultHtml);
      dt.setData('text/plain', '');
      editable.dispatchEvent(new ClipboardEvent('paste', {
        bubbles: true,
        cancelable: true,
        clipboardData: dt,
      }));
      editable.blur();
    };

    const trySet = () => {
      const editable = document.querySelector(
        '.request_description .ck-editor__editable_inline[contenteditable="true"]'
      );
      if (!editable || editable.textContent.trim() !== '') return true;

      paste(editable);

      // paste가 CKEditor에 실제로 반영됐는지 확인
      return editable.textContent.trim() !== '';
    };

    let attempts = 0;
    const retry = () => {
      if (!trySet() && ++attempts < 10) setTimeout(retry, 200);
    };
    retry();
  };

  const initPermissionRequestForm = (user) => {
      const language = window.location.href.includes('ko') ? 'ko' : 'en';
      console.log(language);
      setDescriptionDefault(language);
      setEmailFieldValue(user?.email || "");
  }
  
  // 제거 대상 옵션 제거
  const removeTargetOption = () => {
    const option = document.querySelector(`option[value="${PERMISSION_REQUEST_FORM_ID}"]`);
    if (option) option.remove();
  }

  const formObserve = () => {
    const observer = new MutationObserver((mutations) => {
      mutations.forEach(mutation => {
        mutation.addedNodes.forEach(node => {
          if (node.nodeType !== 1) return;
  
          if (node.nodeName === "OPTION" && node.value === PERMISSION_REQUEST_FORM_ID) {
            node.remove();
            return;
          }
          if (node.nodeName === "LI" && node.id === PERMISSION_REQUEST_FORM_ID) {
            node.remove();
            return;
          }
  
          const targetOption = node.querySelector(`option[value="${PERMISSION_REQUEST_FORM_ID}"]`);
          if (targetOption) targetOption.remove();
          const targetLi = node.querySelector(`li[id="${PERMISSION_REQUEST_FORM_ID}"]`);
          if (targetLi) targetLi.remove();
        });
      });
    });

    observer.observe(document.body, {
      childList: true,
      subtree: true,
    });
  }
  
  document.addEventListener("DOMContentLoaded", async () => {
    if (isLoggedIn) {
      if (window.location.href.includes(`ticket_form_id=${PERMISSION_REQUEST_FORM_ID}`)) {
        const user = await getCurrentUserInfo();
        initPermissionRequestForm(user);
      }
    } else {
      removeTargetOption();
      formObserve();
    }
  });
</script>

