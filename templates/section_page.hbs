{{! Subheader }}
<div class="bg-gray-200">
  <div class="container">
    <div class="row align-items-center pt-4">
      <div class="col font-size-md">
        {{breadcrumbs}}
      </div>
      {{~#is settings.header_search_style 'none'}}
        <div class="md:col-4">
          <div class="search mb-4">
            <h2 class="sr-only">{{t 'search' }}</h2>
            {{~#if settings.search_placeholder}}
              {{#if settings.use_translations}}
                {{search class='form-field mb-0' instant=settings.instant_search scoped=settings.scoped_kb_search submit=false placeholder=(dc settings.search_placeholder)}}
              {{else}}
                {{search class='form-field mb-0' instant=settings.instant_search scoped=settings.scoped_kb_search submit=false placeholder=settings.search_placeholder}}
              {{/if}}
            {{else}}
              {{search class='form-field mb-0' instant=settings.instant_search scoped=settings.scoped_kb_search submit=false}}
            {{/if~}}
            <svg class="search-icon fill-current transition" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" aria-hidden="true">
              <use xlink:href="#icon-search" />
            </svg>
          </div>
        </div>
      {{/is~}}
    </div>
  </div>
</div>

<div class="container" id="page-container">
  <div class="row row-lg">

    <div class="col">

      {{! Section header }}
      <div class="sm:flex flex-wrap justify-content-between mt-4">
        <h1 class="w-full">
          {{section.name}}
        </h1>
        {{#if section.description}}
          <p class="font-size-lg text-gray-600">
            {{section.description}}
          </p>
        {{/if}}

        {{! Subscribe link }}
        {{#if settings.show_follow_section}}
          <div class="subscribe-section mb-4">
            {{subscribe}}
          </div>
        {{/if}}

      </div>

      <div class="row">
        <div class="col-12 {{~#is settings.article_list_columns '1'}} lg:col-9{{/is~}}">

          {{! Subsection list }}
          {{#if section.sections}}
            <ul class="list-unstyled list-bordered border-top border-bottom my-6">
              {{#each section.sections}}
                <li class="bg-white">
                  <h3 class="my-0">
                    <a class="flex align-items-center justify-content-between py-4 text-inherit" href="{{url}}">
                      {{name}}
                      <svg class="fill-current pointer-events-none rotate-270 ml-3" width="14px" viewBox="0 0 40 20" xmlns="http://www.w3.org/2000/svg">
                        <path d="M20,19.5 C19.4,19.5 18.9,19.3 18.4,18.9 L1.4,4.9 C0.3,4 0.2,2.4 1.1,1.4 C2,0.3 3.6,0.2 4.6,1.1 L20,13.8 L35.5,1.1 C36.6,0.2 38.1,0.4 39,1.4 C39.9,2.5 39.7,4 38.7,4.9 L21.7,18.9 C21.1,19.3 20.5,19.5 20,19.5 Z" fill-rule="nonzero"></path>
                      </svg>
                    </a>
                  </h3>
                </li>
              {{/each}}
            </ul>
          {{/if}}

          {{pagination "section.sections"}}

          {{! Article list }}
          {{#if section.articles}}

            {{~#if section.sections}}
              <h2 class="mt-6 h3">
                {{t 'articles'}}
              </h2>
            {{/if~}}

            <div id="article-list-{{section.id}}">
              {{#if (compare settings.article_list_style '<=' '8')}}

                {{! Built-in article list }}
                <ul class="row row-{{~#is settings.article_list_style '1-bullet'}}flush list-disc{{else}}sm list-unstyled{{/is~}}">
                  {{~#each section.articles}}
                    <li class="col-12
                      {{~#if (compare ../settings.article_list_columns ">=" "2")}} md:col-6{{/if~}}
                      {{~#if (compare ../settings.article_list_columns ">=" "3")}} lg:col-4{{/if~}}">

                      <div class="relative media align-items-baseline py-3 h-full
                        {{~#is ../settings.article_list_style '1-bullet'}} pr-7{{/is~}}
                        {{~#is ../settings.promoted_article_style 'bold'}}{{#if promoted}} font-bold{{/if}}{{/is~}}
                        {{~#isnt ../settings.article_list_excerpt 0}} font-semibold{{/isnt~}}
                        {{~#is ../settings.article_list_style '3-bordered'}} border-bottom{{#is ../settings.article_list_columns "1"}}{{#if @last}} border-bottom-0{{/if}}{{/is}}{{/is~}}">

                        {{~#is ../settings.article_list_style '3-bordered'}}
                          <div class="flex" x-data="{ src: Theme.assets['article'] }">
                            <template x-if="src">
                              <img class="svg-icon mr-3" src="{{asset 'placeholder.png'}}" alt="" aria-hidden="true" :src="src" />
                            </template>
                          </div>
                        {{/is~}}

                        <div class="media-body">

                          <a class="link-stretched text-inherit" href="{{url}}">
                            {{~title~}}
                            {{#if promoted}}
                              <div class="promoted-badge">
                                 <img src="{{asset 'icon-bell.svg'}}" alt="" aria-hidden="true" />
                              <span>
                                {{dc 'promoted_article'}}
                              </span>
                              </div>
                            {{/if}}
                            {{~#if internal~}}
                              <svg class="svg-icon ml-1 fill-current text-base" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" aria-hidden="true">
                                <title>{{t 'internal'}}</title>
                                <use xlink:href="#icon-lock" />
                              </svg>
                            {{~/if~}}
                          </a>
                          {{~#isnt ../settings.article_list_excerpt 0}}
                            <p class="my-2 font-size-md break-words font-normal">
                              {{excerpt body characters=../settings.article_list_excerpt}}
                            </p>
                          {{/isnt~}}
                          <div class="popup-controller">
                            {{#if promoted}}
                              <div class="popup-off" data-article-id={{id}}>
                                <img src="{{asset 'icon-bell-on.svg'}}" alt="" aria-hidden="true" />
                              </div>
                            {{else}}
                              <div class="popup-on" data-article-id={{id}}>
                                <img src="{{asset 'icon-bell-off.svg'}}" alt="" aria-hidden="true" />
                              </div>
                            {{/if}}
                          </div>
                        </div>
                      </div>
                    </li>
                  {{/each~}}
                </ul>
              {{else}}

                {{! Custom micro-template }}
                <script type="text/javascript">
                  ready(function() {
                    new Navigation(document.getElementById('article-list-{{section.id}}'), {
                      collection: Theme.contentBlocks || {},
                      template: 'articles',
                      sectionId: {{section.id}},
                      templateData: {
                        sectionId: {{section.id}},
                        numberColumns: {{settings.article_list_columns}},
                        excerptLength: {{settings.article_list_excerpt}},
                        promotedArticleStyle: "{{settings.promoted_article_style}}"
                      }
                    });
                  });
                </script>
              {{/if}}
            </div>
          {{else}}
            {{#unless section.sections}}
              <p class="mt-5">
                <a href="{{section.url}}">
                  {{t 'empty'}}
                </a>
              </p>
            {{/unless}}
          {{/if}}

          {{pagination "section.articles"}}

        </div>
      </div>
    </div>

    {{! Sidebar }}
    <aside class="relative lg:col-4{{#is settings.section_sidebar 'none'}}{{~#isnt settings.cta_style 'sidebar'}} hidden{{/isnt}}{{/is}}">

      {{! Sidebar navigation }}
      {{~#isnt settings.section_sidebar 'none'}}
        <div
          data-element="navigation"
          data-template="{{#is settings.section_sidebar 'custom'}}sidebar-navigation{{else}}{{settings.section_sidebar}}{{/is}}">
        </div>
      {{/isnt~}}

      {{! Call-to-action }}
      {{~#is settings.cta_style 'sidebar'}}
        {{~#isnt settings.cta_location 'home'}}
          <div
            data-element="template"
            data-template="call-to-action">
          </div>
        {{/isnt~}}
      {{/is~}}

    </aside>

  </div> {{! /.row }}
</div> {{! /#page-container }}

{{! Call-to-action }}
{{~#isnt settings.cta_style 'none'}}
  {{~#isnt settings.cta_style 'sidebar'}}
    {{~#isnt settings.cta_location 'home'}}
      <div
        data-element="template"
        data-template="call-to-action">
      </div>
    {{/isnt~}}
  {{/isnt~}}
{{/isnt~}}

<script type="text/javascript">document.documentElement.classList.add('section-page', 'section-' + {{section.id}})</script>
<script>
	const AUTHORIZED_SEGMENT_IDS = [12513489179791, 26978513566748];
	const SIDEAPP_ID = 1241898;
	const USER_CACHE_KEY = "hmg_user_cache";
	const USER_TTL_MS = 2 * 60 * 1000;
  let currentUserEmail = '';

	async function fetchCurrentUser() {
		const cached = JSON.parse(localStorage.getItem(USER_CACHE_KEY) || "null");
		if (cached && Date.now() - cached.fetchedAt < USER_TTL_MS) {
			return cached;
		}
		const res = await fetch("/api/v2/users/me.json");
		const data = await res.json();
		const csrfToken =
			data.authenticity_token ??
			data.current_user?.authenticity_token ??
			data.user?.authenticity_token;
		if (!csrfToken) throw new Error("authenticity_token 없음 — 응답: " + JSON.stringify(data));
		const user = { csrfToken, id: data.user?.id ?? null, fetchedAt: Date.now() };
		localStorage.setItem(USER_CACHE_KEY, JSON.stringify(user));
		currentUserEmail = data.user?.email ?? '';
		return user;
	}

	async function getCsrfToken() {
		const { csrfToken } = await fetchCurrentUser();
		return csrfToken;
	}


	async function initPopupController() {
		const controllers = document.querySelectorAll(".popup-controller");
		if (!controllers.length) {
			console.warn("[popup-controller] .popup-controller 요소 없음 — 종료");
			return;
		}
		try {
			const { id: userId } = await fetchCurrentUser();
			if (!userId) {
				console.warn("[popup-controller] user.id 없음 — 비로그인 상태");
				return;
			}
			const segRes = await fetch(`/api/v2/help_center/users/${userId}/user_segments`);
			const segData = await segRes.json();
			const hasAccess = segData.user_segments?.some((seg) =>
				AUTHORIZED_SEGMENT_IDS.includes(seg.id)
			);
			if (hasAccess) {
				controllers.forEach((el) => el.classList.add("is-authorized"));
			}
		} catch (err) {
			console.error("[popup-controller] 권한 확인 실패:", err);
		}
	}
	initPopupController();

	function getSectionId() {
		const match = document.documentElement.className.match(/section-(\d+)/);
		return match ? Number(match[1]) : null;
	}

	async function updateArticlePromoted(articleId, promoted) {
		const token = await getCsrfToken();
		const res = await fetch(`/api/v2/help_center/articles/${articleId}`, {
			method: "PUT",
			headers: {
				"Content-Type": "application/json",
				"X-CSRF-Token": token
			},
			body: JSON.stringify({ article: { promoted } })
		});
		if (!res.ok) throw new Error(`HTTP ${res.status}`);
		return res.json();
	}

	async function notifySideapp(articleId, sectionId, event) {
		const csrfToken = await getCsrfToken();
		const payload = {
			app_id: SIDEAPP_ID,
			event,
			body: { article_id: articleId, section_id: sectionId }
		};
		const res = await fetch("/api/v2/apps/notify", {
			method: "POST",
			headers: {
				"Content-Type": "application/json",
				"X-CSRF-Token": csrfToken
			},
			body: JSON.stringify(payload)
		});
		if (!res.ok) throw new Error(`HTTP ${res.status}`);
	}

	document.addEventListener("click", async (e) => {
		const btn = e.target.closest(".popup-off, .popup-on");
		if (!btn) return;

		const controller = btn.closest(".popup-controller");
		if (!controller?.classList.contains("is-authorized")) return;

		const articleId = Number(btn.dataset.articleId);
		const isOff = btn.classList.contains("popup-off");
		const sectionId = getSectionId();
		const notifyEvent = isOff ? "article.unpublished" : "article.published";

		try {
			await updateArticlePromoted(articleId, !isOff);
			await notifySideapp(articleId, sectionId, notifyEvent);
			window.location.reload();
		} catch (err) {
			console.error("[popup-controller] 변경 실패:", err);
		}
	});
</script>